{
  "name": "mcp-nlm",
  "version": "0.1.6",
  "description": "On-demand stdio proxy for the latest NotebookLM MCP server.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kucharskill/mcp-nlm.git"
  },
  "homepage": "https://github.com/kucharskill/mcp-nlm#readme",
  "bugs": {
    "url": "https://github.com/kucharskill/mcp-nlm/issues"
  },
  "bin": {
    "mcp-nlm": "cli.js"
  },
  "files": [
    "cli.js",
    "proxy.js",
    "discovery-cache.js",
    "startup-env.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check cli.js && node --check proxy.js && node --check discovery-cache.js && node --check startup-env.js && node --test",
    "release:prepare": "npm run check && node scripts/prepare-release.mjs",
    "release:publish": "node scripts/publish-release.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
